
@model List<BiteBudget.Models.Meal>

@{
    ViewData["Title"] = "Smart Meal Finder";
    var budgetValue = ViewBag.Budget;
    var selectedPreference = ViewBag.Preference as string ?? "All";
}

<style>
    .mf-page {
        background: #f7f7f0;
        color: #19382d;
        min-height: 100vh;
        padding: 35px 0 60px;
        font-family: Arial, sans-serif;
    }

    .mf-container {
        width: min(1180px, 92%);
        margin: auto;
    }

    .mf-eyebrow {
        color: #287451;
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 2px;
        margin-bottom: 12px;
    }

    .mf-title {
        font-size: clamp(30px, 5vw, 46px);
        font-weight: 800;
        letter-spacing: -1.5px;
        line-height: 1.15;
        margin: 0 0 14px;
    }

    .mf-subtitle {
        color: #718078;
        line-height: 1.7;
        max-width: 620px;
        margin-bottom: 26px;
    }

    .mf-hero {
        background: linear-gradient(120deg, #173e30, #286448);
        border-radius: 24px;
        padding: clamp(24px, 5vw, 42px);
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 30px;
    }

    .mf-hero h2 {
        font-size: clamp(23px, 3vw, 32px);
        font-weight: 800;
        margin: 0 0 12px;
    }

    .mf-hero p {
        color: #d4e5d8;
        line-height: 1.7;
        margin: 0;
        max-width: 580px;
    }

    .mf-hero-icon {
        font-size: clamp(48px, 7vw, 76px);
        background: #ffffff16;
        padding: 14px;
        border-radius: 20px;
        flex-shrink: 0;
    }

    .mf-filter {
        background: white;
        border: 1px solid #e6eade;
        border-radius: 20px;
        padding: 23px;
        margin-bottom: 30px;
        box-shadow: 0 7px 25px #203d2608;
    }

    .mf-filter h3 {
        font-size: 18px;
        font-weight: 800;
        margin: 0 0 18px;
    }

    .mf-filter-row {
        display: grid;
        grid-template-columns: 1fr 1fr auto;
        align-items: end;
        gap: 15px;
    }

    .mf-label {
        display: block;
        color: #52685c;
        font-size: 13px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .mf-input {
        width: 100%;
        box-sizing: border-box;
        min-height: 46px;
        padding: 11px 13px;
        border: 1px solid #dfe6dc;
        border-radius: 11px;
        background: #fcfdf9;
        color: #19382d;
        font-size: 14px;
    }

    .mf-input:focus {
        outline: 2px solid #9bc8a7;
        border-color: #287451;
    }

    .mf-btn {
        display: inline-block;
        border: 0;
        border-radius: 11px;
        padding: 14px 19px;
        font-size: 13px;
        font-weight: 800;
        text-decoration: none;
        text-align: center;
        cursor: pointer;
        transition: .2s;
    }

    .mf-btn-primary {
        background: #287451;
        color: white;
    }

    .mf-btn-primary:hover {
        background: #193e2e;
        color: white;
        transform: translateY(-2px);
    }

    .mf-btn-light {
        background: #edf4ec;
        color: #287451;
    }

    .mf-btn-light:hover {
        background: #dcebdd;
        color: #193e2e;
    }

    .mf-section-heading {
        display: flex;
        justify-content: space-between;
        align-items: end;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 20px;
    }

    .mf-section-heading h2 {
        font-size: 25px;
        font-weight: 800;
        margin: 0 0 7px;
    }

    .mf-section-heading p {
        color: #718078;
        font-size: 13px;
        margin: 0;
    }

    .mf-count {
        color: #287451;
        background: #e2f3e7;
        border-radius: 30px;
        padding: 8px 12px;
        font-size: 12px;
        font-weight: 800;
    }

    .mf-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 21px;
    }

    .mf-card {
        display: flex;
        flex-direction: column;
        background: white;
        border: 1px solid #e8ebdf;
        border-radius: 20px;
        padding: 23px;
        box-shadow: 0 7px 25px #203d2608;
        transition: transform .2s, box-shadow .2s;
        min-width: 0;
    }

    .mf-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 32px #203d2615;
    }

    .mf-card-top {
        display: flex;
        align-items: start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 19px;
    }

    .mf-food-icon {
        display: grid;
        place-items: center;
        width: 57px;
        height: 57px;
        border-radius: 17px;
        background: #edf4ec;
        font-size: 30px;
    }

    .mf-category {
        display: inline-block;
        color: #68796d;
        background: #f3f5ee;
        border-radius: 30px;
        padding: 7px 10px;
        font-size: 11px;
        font-weight: 700;
    }

    .mf-diet {
        color: #287451;
        font-size: 11px;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .mf-card h3 {
        font-size: 20px;
        font-weight: 800;
        line-height: 1.35;
        margin: 0 0 10px;
    }

    .mf-description {
        color: #718078;
        font-size: 13px;
        line-height: 1.7;
        min-height: 44px;
        margin: 0 0 20px;
    }

    .mf-nutrition {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 20px;
    }

    .mf-nutrition-item {
        background: #f7f8f2;
        border-radius: 12px;
        padding: 12px;
    }

    .mf-nutrition-item strong {
        display: block;
        font-size: 17px;
        margin-bottom: 5px;
    }

    .mf-nutrition-item span {
        color: #829087;
        font-size: 11px;
    }

    .mf-card-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: auto;
        padding-top: 18px;
        border-top: 1px solid #edf0e8;
    }

    .mf-price-label {
        display: block;
        color: #829087;
        font-size: 11px;
        margin-bottom: 5px;
    }

    .mf-price {
        color: #19382d;
        font-size: 25px;
        font-weight: 800;
    }

    .mf-add-form { margin: 0; }

    .mf-empty {
        background: white;
        border: 1px solid #e8ebdf;
        border-radius: 20px;
        padding: 45px 20px;
        text-align: center;
    }

    .mf-empty-icon {
        font-size: 45px;
        margin-bottom: 15px;
    }

    .mf-empty h3 {
        font-weight: 800;
        margin-bottom: 10px;
    }

    .mf-empty p {
        color: #718078;
        margin-bottom: 20px;
    }

    .mf-bottom-note {
        background: #e9f3e8;
        color: #496858;
        border-radius: 16px;
        padding: 18px;
        margin-top: 30px;
        font-size: 13px;
        line-height: 1.7;
    }

    @@media (max-width: 900px) {
        .mf-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    @@media (max-width: 620px) {
        .mf-grid { grid-template-columns: 1fr; }
        .mf-filter-row { grid-template-columns: 1fr; }
        .mf-hero { align-items: start; }
        .mf-hero-icon { font-size: 42px; }
        .mf-card { padding: 20px; }
    }
</style>

<div class="mf-page">
    <div class="mf-container">

        <div class="mf-eyebrow">🥗 SMART FOOD, SMART SPENDING</div>
        <h1 class="mf-title">Eat well. Spend smart.</h1>
        <p class="mf-subtitle">
            Discover meals that fit your budget and food preferences.
            Compare prices, calories and protein before you order.
        </p>

        <section class="mf-hero">
            <div>
                <h2>Your budget deserves better food.</h2>
                <p>
                    Find satisfying meals without overspending.
                    Set a budget, choose your preference and discover your next favourite meal.
                </p>
            </div>
            <div class="mf-hero-icon">🍲</div>
        </section>

        <section class="mf-filter">
            <h3>Find your perfect meal</h3>

            <form method="get" asp-controller="Meals" asp-action="Index">
                <div class="mf-filter-row">
                    <div>
                        <label class="mf-label" for="budget">Maximum budget (₹)</label>
                        <input class="mf-input"
                               id="budget"
                               name="budget"
                               type="number"
                               min="1"
                               step="1"
                               placeholder="e.g. 150"
                               value="@budgetValue" />
                    </div>

                    <div>
                        <label class="mf-label" for="preference">Food preference</label>
                        <select class="mf-input" id="preference" name="preference">
                            <option value="All" selected="@(selectedPreference == "All")">All meals</option>
                            <option value="Vegetarian" selected="@(selectedPreference == "Vegetarian")">Vegetarian</option>
                            <option value="NonVegetarian" selected="@(selectedPreference == "NonVegetarian")">Non-vegetarian</option>
                        </select>
                    </div>

                    <button class="mf-btn mf-btn-primary" type="submit">
                        Find Meals →
                    </button>
                </div>

                <div style="margin-top: 14px;">
                    <a class="mf-link" asp-controller="Meals" asp-action="Index"
                       style="color:#287451;font-size:13px;text-decoration:none;">
                        Clear filters
                    </a>
                </div>
            </form>
        </section>

        <section>
            <div class="mf-section-heading">
                <div>
                    <h2>Explore the menu</h2>
                    <p>Delicious choices, with prices and nutrition at a glance.</p>
                </div>
                <span class="mf-count">@Model.Count meal(s) found</span>
            </div>

            @if (!Model.Any())
            {
                <div class="mf-empty">
                    <div class="mf-empty-icon">🥑</div>
                    <h3>No meals match your filters</h3>
                    <p>Try a higher budget or another food preference.</p>
                    <a class="mf-btn mf-btn-primary"
                       asp-controller="Meals" asp-action="Index">
                        Show all meals
                    </a>
                </div>
            }
            else
            {
                <div class="mf-grid">
                    @foreach (var meal in Model)
                    {
                        <article class="mf-card">
                            <div class="mf-card-top">
                                <div class="mf-food-icon">
                                    @(meal.Name.Contains("Paneer", StringComparison.OrdinalIgnoreCase) ? "🍛" :
                                      meal.Name.Contains("Chicken", StringComparison.OrdinalIgnoreCase) ? "🍗" :
                                      meal.Name.Contains("Sandwich", StringComparison.OrdinalIgnoreCase) ? "🥪" :
                                      meal.Name.Contains("Egg", StringComparison.OrdinalIgnoreCase) ? "🍳" :
                                      meal.Name.Contains("Khichdi", StringComparison.OrdinalIgnoreCase) ? "🥣" : "🍽️")
                                </div>
                                <span class="mf-category">@meal.Category</span>
                            </div>

                            <div class="mf-diet">
                                @(meal.IsVegetarian ? "● VEGETARIAN" : "● NON-VEGETARIAN")
                            </div>

                            <h3>@meal.Name</h3>
                            <p class="mf-description">@meal.Description</p>

                            <div class="mf-nutrition">
                                <div class="mf-nutrition-item">
                                    <strong>@meal.Calories</strong>
                                    <span>Calories (kcal)</span>
                                </div>
                                <div class="mf-nutrition-item">
                                    <strong>@meal.Protein g</strong>
                                    <span>Protein</span>
                                </div>
                            </div>

                            <div class="mf-card-bottom">
                                <div>
                                    <span class="mf-price-label">PRICE</span>
                                    <span class="mf-price">₹@meal.Price</span>
                                </div>

                                <form class="mf-add-form"
                                      asp-controller="Cart"
                                      asp-action="Add"
                                      method="post">
                                    <input type="hidden" name="mealId" value="@meal.Id" />
                                    <button class="mf-btn mf-btn-primary" type="submit">
                                        Add to cart +
                                    </button>
                                </form>
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <div class="mf-bottom-note">
            💡 <strong>Smart spending tip:</strong> Compare the listed prices and
            nutrition values to find an option that suits your budget.
            Nutrition information is illustrative and should be verified for real-world use.
        </div>
    </div>
</div>
