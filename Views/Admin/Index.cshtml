
@{
    ViewData["Title"] = "Admin Dashboard";
    var recentOrders = ViewBag.RecentOrders
        as List<BiteBudget.Models.Order>
        ?? new List<BiteBudget.Models.Order>();
}

<style>
    .bb-dashboard {
        background: #f7f7f0;
        min-height: 100vh;
        padding: 32px 0 60px;
        color: #19382d;
        font-family: Arial, sans-serif;
    }

    .bb-container {
        width: min(1180px, 92%);
        margin: auto;
    }

    .bb-topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
        margin-bottom: 32px;
    }

    .bb-brand {
        font-size: 15px;
        font-weight: 800;
        letter-spacing: 2px;
        color: #287451;
        margin-bottom: 10px;
    }

    .bb-title {
        font-size: clamp(28px, 4vw, 40px);
        font-weight: 800;
        letter-spacing: -1.5px;
        margin: 0 0 8px;
    }

    .bb-subtitle {
        color: #718078;
        margin: 0;
        font-size: 14px;
    }

    .bb-date {
        background: white;
        border: 1px solid #e5e9df;
        border-radius: 14px;
        padding: 13px 17px;
        color: #496257;
        font-size: 13px;
    }

    .bb-welcome {
        background: linear-gradient(115deg, #173e30, #286448);
        color: white;
        border-radius: 24px;
        padding: 30px;
        margin-bottom: 27px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        overflow: hidden;
    }

    .bb-welcome h2 {
        font-size: clamp(22px, 3vw, 30px);
        font-weight: 800;
        margin: 0 0 10px;
    }

    .bb-welcome p {
        color: #d1e3d6;
        margin: 0;
        line-height: 1.7;
    }

    .bb-welcome-icon {
        font-size: 65px;
        background: #ffffff16;
        border-radius: 22px;
        padding: 14px 20px;
    }

    .bb-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .bb-stat {
        background: white;
        border: 1px solid #e9ebdf;
        border-radius: 20px;
        padding: 23px;
        box-shadow: 0 7px 25px #203d2610;
        transition: transform .2s, box-shadow .2s;
    }

    .bb-stat:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 30px #203d2618;
    }

    .bb-stat-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .bb-stat-label {
        color: #718078;
        font-size: 14px;
        font-weight: 600;
    }

    .bb-stat-icon {
        display: grid;
        place-items: center;
        width: 45px;
        height: 45px;
        border-radius: 14px;
        font-size: 22px;
    }

    .bb-green { background: #e2f3e7; }
    .bb-orange { background: #fff0d8; }
    .bb-blue { background: #e5efff; }

    .bb-stat-number {
        font-size: clamp(27px, 3vw, 35px);
        font-weight: 800;
        margin: 21px 0 7px;
        letter-spacing: -1px;
        overflow-wrap: anywhere;
    }

    .bb-stat-note {
        color: #829087;
        font-size: 12px;
    }

    .bb-panel {
        background: white;
        border: 1px solid #e9ebdf;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 7px 25px #203d260a;
    }

    .bb-panel-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
        margin-bottom: 22px;
    }

    .bb-panel-heading h3 {
        font-size: 20px;
        font-weight: 800;
        margin: 0 0 6px;
    }

    .bb-panel-heading p {
        color: #829087;
        font-size: 13px;
        margin: 0;
    }

    .bb-link {
        color: #287451;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
    }

    .bb-link:hover { text-decoration: underline; }

    .bb-table-wrap {
        overflow-x: auto;
        width: 100%;
    }

    .bb-table {
        border-collapse: collapse;
        width: 100%;
        min-width: 650px;
        font-size: 13px;
    }

    .bb-table th {
        text-align: left;
        color: #879187;
        font-size: 11px;
        letter-spacing: .8px;
        text-transform: uppercase;
        background: #f8f9f5;
        padding: 15px 13px;
        border-bottom: 1px solid #e9ebdf;
    }

    .bb-table td {
        padding: 17px 13px;
        border-bottom: 1px solid #edf0e8;
        color: #41584c;
    }

    .bb-table tbody tr:last-child td { border-bottom: none; }
    .bb-table tbody tr:hover { background: #fafbf7; }

    .bb-order-id {
        color: #287451;
        font-weight: 800;
    }

    .bb-customer {
        color: #19382d;
        font-weight: 700;
    }

    .bb-status {
        display: inline-block;
        border-radius: 30px;
        padding: 6px 10px;
        font-size: 11px;
        font-weight: 700;
        background: #fff0d8;
        color: #9a681b;
        white-space: nowrap;
    }

    .bb-status-paid {
        background: #e2f3e7;
        color: #287451;
    }

    .bb-total {
        font-weight: 800;
        color: #19382d;
        white-space: nowrap;
    }

    .bb-empty {
        text-align: center;
        padding: 45px 15px;
        color: #718078;
    }

    .bb-empty-icon {
        font-size: 42px;
        margin-bottom: 12px;
    }

    .bb-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 25px;
    }

    .bb-btn {
        display: inline-block;
        text-decoration: none;
        border-radius: 12px;
        padding: 13px 19px;
        font-size: 13px;
        font-weight: 700;
        transition: .2s;
    }

    .bb-btn-primary {
        background: #287451;
        color: white;
    }

    .bb-btn-primary:hover {
        background: #193e2e;
        color: white;
        transform: translateY(-2px);
    }

    .bb-btn-secondary {
        background: white;
        border: 1px solid #dfe6dc;
        color: #287451;
    }

    .bb-btn-secondary:hover {
        background: #eaf4ec;
        color: #193e2e;
    }

    .bb-footer {
        text-align: center;
        color: #96a096;
        font-size: 12px;
        margin-top: 32px;
    }

    @@media (max-width: 760px) {
        .bb-stats { grid-template-columns: 1fr; }
        .bb-stat { padding: 20px; }
        .bb-welcome { padding: 23px; }
        .bb-welcome-icon { font-size: 42px; padding: 10px; }
        .bb-panel { padding: 17px; }
    }
</style>

<div class="bb-dashboard">
    <div class="bb-container">

        <header class="bb-topbar">
            <div>
                <div class="bb-brand">🥗 BITEBUDGET</div>
                <h1 class="bb-title">Admin Dashboard</h1>
                <p class="bb-subtitle">Your food business, at a glance.</p>
            </div>
            <div class="bb-date">
                📅 @DateTime.Now.ToString("dddd, dd MMM yyyy")
            </div>
        </header>

        <section class="bb-welcome">
            <div>
                <h2>Welcome to BiteBudget 👋</h2>
                <p>Track orders, monitor order values and manage your meal menu
                    from one place.</p>
            </div>
            <div class="bb-welcome-icon">🍱</div>
        </section>

        <section class="bb-stats">
            <div class="bb-stat">
                <div class="bb-stat-top">
                    <span class="bb-stat-label">Total Orders</span>
                    <span class="bb-stat-icon bb-green">📦</span>
                </div>
                <div class="bb-stat-number">@ViewBag.TotalOrders</div>
                <div class="bb-stat-note">All recorded customer orders</div>
            </div>

            <div class="bb-stat">
                <div class="bb-stat-top">
                    <span class="bb-stat-label">Order Value</span>
                    <span class="bb-stat-icon bb-orange">₹</span>
                </div>
                <div class="bb-stat-number">₹@(((decimal)ViewBag.TotalRevenue).ToString("N2"))</div>
                <div class="bb-stat-note">Combined value of recorded orders</div>
            </div>

            <div class="bb-stat">
                <div class="bb-stat-top">
                    <span class="bb-stat-label">Available Meals</span>
                    <span class="bb-stat-icon bb-blue">🍽️</span>
                </div>
                <div class="bb-stat-number">@ViewBag.TotalMeals</div>
                <div class="bb-stat-note">Meals currently in your menu</div>
            </div>
        </section>

        <section class="bb-panel">
            <div class="bb-panel-heading">
                <div>
                    <h3>Recent Orders</h3>
                    <p>Keep an eye on the latest customer activity.</p>
                </div>
                <a class="bb-link" asp-controller="Orders" asp-action="Index">
                    View all orders →
                </a>
            </div>

            @if (!recentOrders.Any())
            {
                <div class="bb-empty">
                    <div class="bb-empty-icon">🛍️</div>
                    <h3>No orders yet</h3>
                    <p>Your recent customer orders will appear here.</p>
                    <a class="bb-btn bb-btn-primary"
                       asp-controller="Meals" asp-action="Index">
                        Explore the menu
                    </a>
                </div>
            }
            else
            {
                <div class="bb-table-wrap">
                    <table class="bb-table">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th>Payment</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in recentOrders)
                            {
                                <tr>
                                    <td class="bb-order-id">#@order.Id</td>
                                    <td class="bb-customer">@order.CustomerName</td>
                                    <td>@order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="bb-status @(order.PaymentStatus == "Paid" ? "bb-status-paid" : "")">
                                            @order.PaymentStatus
                                        </span>
                                    </td>
                                    <td class="bb-total">₹@order.Total.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <div class="bb-actions">
            <a class="bb-btn bb-btn-primary"
               asp-controller="Meals" asp-action="Index">
                + Browse Meals
            </a>
            <a class="bb-btn bb-btn-secondary"
               asp-controller="Orders" asp-action="Index">
                📋 Manage Orders
            </a>
            <a class="bb-btn bb-btn-secondary"
               asp-controller="Cart" asp-action="Index">
                🛒 View Cart
            </a>
        </div>

        <footer class="bb-footer">
            BiteBudget · Smart Food Ordering System · Admin Overview
        </footer>

    </div>
</div>
